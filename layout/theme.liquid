<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {%- if template.name == 'index' -%}
        {{ shop.name }} - Funny hand-printed t-shirts
      {%- else -%}
        {{ page_title }} | {{ shop.name }}
      {%- endif -%}
    </title>
    {% render 'meta-tags' %}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    {{ 'booyah.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'booyah.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#main_content">Skip to content</a>
    {%- comment -%}
      The home page background (the big shirt graphic from the original site)
      lives in the repo at assets/tshirtbooyah_logo_final.gif.
    {%- endcomment -%}
    {%- if template.name == 'index' -%}
      {%- capture container_style -%}
        background-image: url({{ 'tshirtbooyah_logo_final.gif' | asset_url }});
      {%- endcapture -%}
    {%- endif -%}
    <div id="container" {% if container_style %}class="has-home-background" style="{{ container_style | strip }}"{% endif %}>
      {% sections 'header-group' %}

      <main id="main_content" role="main">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>
  </body>
</html>
