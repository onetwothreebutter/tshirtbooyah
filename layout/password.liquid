<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} - Opening soon</title>
    {{ 'booyah.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <div id="container">
      <header id="header" class="header-banner">
        <div class="image-nav">
          <img src="{{ 'tshirtbooyah_header.gif' | asset_url }}" alt="{{ shop.name | escape }}" width="802" height="125">
        </div>
      </header>
      <main id="main_content" role="main">
        {{ content_for_layout }}
      </main>
    </div>
  </body>
</html>
