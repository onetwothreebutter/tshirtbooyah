<div id="product_container" class="text-page">
  <div class="detailentry">
    <div class="page_header"><h1>{{ page.title }}</h1></div>
    <div class="rte">{{ page.content }}</div>

    {%- form 'contact', class: 'contact-form', data-contact-form: '' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">Thanks! Your message is on its way.</p>
      {%- endif -%}
      {{ form.errors | default_errors }}
      <div class="form-item">
        <label for="ContactName">Your name</label>
        <input type="text" id="ContactName" name="contact[name]" class="form-text" value="{{ form.name }}" autocomplete="name">
      </div>
      <div class="form-item">
        <label for="ContactEmail">Your e-mail address <span class="form-required">*</span></label>
        <input type="email" id="ContactEmail" name="contact[email]" class="form-text" value="{{ form.email }}" required autocomplete="email">
      </div>
      <div class="form-item">
        <label for="ContactBody">Message <span class="form-required">*</span></label>
        <textarea id="ContactBody" name="contact[body]" class="form-textarea" rows="8" required>{{ form.body }}</textarea>
      </div>
      <button type="submit" class="form-submit">Send e-mail</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Contact page", "settings": [] }
{% endschema %}
