<footer class="site-footer{% if template.name == 'index' %} site-footer--home{% endif %}">
  <div class="site-footer__rule">
    {%- liquid
      assign about_url = section.settings.about_page.url | default: '/pages/about'
      assign contact_url = section.settings.contact_page.url | default: '/pages/contact'
      assign iowa_page = section.settings.iowa_page | default: pages['iowa']
    -%}
    <nav class="site-footer__links" aria-label="Footer">
      <a href="{{ about_url }}">About</a>
      <a href="{{ contact_url }}">Contact</a>
      {%- if iowa_page != blank and iowa_page.url != blank %}
      <a href="{{ iowa_page.url }}">Iowa shirts</a>
      {%- endif %}
      {%- comment -%} Store policies from Shopify Settings > Policies; each shows once it's written. {%- endcomment -%}
      {%- if shop.shipping_policy.url != blank %}
      <a href="{{ shop.shipping_policy.url }}">Shipping</a>
      {%- endif %}
      {%- if shop.refund_policy.url != blank %}
      <a href="{{ shop.refund_policy.url }}">Returns</a>
      {%- endif %}
      {%- if shop.privacy_policy.url != blank %}
      <a href="{{ shop.privacy_policy.url }}">Privacy</a>
      {%- endif %}
      {%- if shop.terms_of_service.url != blank %}
      <a href="{{ shop.terms_of_service.url }}">Terms</a>
      {%- endif %}
    </nav>
    &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name }}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "default": "TshirtBooyah"
    },
    {
      "type": "page",
      "id": "about_page",
      "label": "About page",
      "info": "Defaults to /pages/about"
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "Contact page",
      "info": "Defaults to /pages/contact"
    },
    {
      "type": "page",
      "id": "iowa_page",
      "label": "Iowa page",
      "info": "Defaults to the page with handle \"iowa\". The link only shows once that page is published."
    }
  ]
}
{% endschema %}
