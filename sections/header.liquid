{%- comment -%}
  Two header looks, both copied from the original Drupal theme:
  - Home page: the stand-alone logo plus the "ABOUT CONTACT CART" nav image.
  - Every other page: the single wide banner (logo + nav inside a red outline).
  The original used <map> image maps. Image maps break when the image scales
  on small screens, so the clickable areas are absolutely positioned links,
  sized in percentages from the original map coordinates.
{%- endcomment -%}

{%- liquid
  assign about_url = section.settings.about_page.url | default: '/pages/about'
  assign contact_url = section.settings.contact_page.url | default: '/pages/contact'
-%}

{%- if template.name == 'index' -%}
  <header id="header1" class="header-home">
    <a href="{{ routes.root_url }}" class="header-home__logo">
      <img src="{{ 'tshirtbooyah_logo_main.gif' | asset_url }}" alt="{{ shop.name | escape }}" width="296" height="120">
    </a>
    <nav class="header-home__nav image-nav" aria-label="Main">
      <img src="{{ 'tshirtbooyah_nav_noblog.gif' | asset_url }}" alt="" width="295" height="25">
      {%- comment -%} original coords on 295x25: about 0-90, contact 95-205, cart 215-295 {%- endcomment -%}
      <a href="{{ about_url }}" style="left:0;width:30.5%;top:0;height:100%;">About</a>
      <a href="{{ contact_url }}" style="left:32.2%;width:37.3%;top:0;height:100%;">Contact</a>
      <a href="{{ routes.cart_url }}" style="left:72.9%;width:27.1%;top:0;height:100%;">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
      {%- if cart.item_count > 0 -%}
        <span class="cart-count cart-count--home" aria-hidden="true">{{ cart.item_count }}</span>
      {%- endif -%}
    </nav>
  </header>
{%- else -%}
  <header id="header" class="header-banner">
    <nav class="image-nav" aria-label="Main">
      <img src="{{ 'tshirtbooyah_header.gif' | asset_url }}" alt="" width="802" height="125">
      {%- comment -%} original coords on 802x125: store 38-277 x 0-102, about 423-505, contact 516-629, cart 640-709 (y 57-77) {%- endcomment -%}
      <a href="{{ routes.root_url }}" style="left:4.7%;width:29.8%;top:0;height:81.6%;">{{ shop.name }}</a>
      <a href="{{ about_url }}" style="left:52.7%;width:10.2%;top:45.6%;height:16%;">About</a>
      <a href="{{ contact_url }}" style="left:64.3%;width:14.1%;top:45.6%;height:16%;">Contact</a>
      <a href="{{ routes.cart_url }}" style="left:79.8%;width:8.6%;top:45.6%;height:16%;">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
      {%- if cart.item_count > 0 -%}
        {%- comment -%} Red bubble with the number of shirts in the cart, at the top right of the CART word. {%- endcomment -%}
        <span class="cart-count cart-count--banner" aria-hidden="true">{{ cart.item_count }}</span>
      {%- endif -%}
    </nav>
  </header>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "page",
      "id": "about_page",
      "label": "About page",
      "info": "Defaults to /pages/about"
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "Contact page",
      "info": "Defaults to /pages/contact"
    }
  ]
}
{% endschema %}
