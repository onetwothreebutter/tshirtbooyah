{%- comment -%}
  Home page grid: 3 squares per row, 9 per page, with the old Drupal-style
  pager ("1 2 next › last »") underneath.
{%- endcomment -%}
{%- comment -%}
  Shopify can only paginate a collection reached by a direct path, not one
  stored in a variable with assign, so each source gets its own paginate block.
{%- endcomment -%}
<div id="product_container" class="product-grid">
  {%- if section.settings.collection != blank -%}
    {%- assign handle = section.settings.collection.handle -%}
    {%- paginate collections[handle].products by section.settings.per_page -%}
      {% render 'product-grid-items', products: collections[handle].products, paginate: paginate %}
    {%- endpaginate -%}
  {%- else -%}
    {%- paginate collections.all.products by section.settings.per_page -%}
      {% render 'product-grid-items', products: collections.all.products, paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 3,
      "max": 30,
      "step": 3,
      "default": 9
    }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
