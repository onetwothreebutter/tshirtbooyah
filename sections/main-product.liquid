{%- comment -%}
  Product page, laid out like the original Ubercart page:
  boxed title, big photo on the left (click it to zoom), Description + big price + color
  swatches + size dropdown + "Add to cart" + "Good to know" info on the right, design thumbnails with a zoom
  icon underneath that open the full-size image.

  POD apps (Printful, Printify) attach one mockup per color to the variants,
  so the main photo follows the selected variant, and the small "design"
  row only shows the custom.thumbnail metafield plus media that no variant
  uses.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign main_media = current_variant.featured_media | default: product.featured_media
  assign variant_media_ids = ''
  for variant in product.variants
    if variant.featured_media
      assign variant_media_ids = variant_media_ids | append: ',' | append: variant.featured_media.id | append: ','
    endif
  endfor
  assign design_thumb = product.metafields.custom.thumbnail.value
-%}
<div id="product_container" class="product-page">
  <div class="detailentry">
    <div class="page_header">
      <h1>{{ product.title }}</h1>
    </div>

    <div class="product-columns">
      <div id="img_main">
        {%- if main_media -%}
          {%- assign main_alt = main_media.alt | default: product.title -%}
          <a href="{{ main_media.preview_image | image_url: width: 1600 }}" class="main-image-zoom" title="Click to zoom" data-lightbox data-main-image-link>
            {{- main_media.preview_image | image_url: width: 700 | image_tag: width: 350, alt: main_alt, data-main-image: '' -}}
          </a>
        {%- endif -%}
      </div>

      <div class="product-info">
        <div class="product-info__description">
          <div class="product-info__label">Description</div>
          <div class="product-body">{{ product.description }}</div>
        </div>

        <div id="details_infobox">
          <span class="catalogprice" data-price>{{ current_variant.price | money_without_trailing_zeros }}</span>

          {%- form 'product', product, class: 'add-to-cart', data-product-form: '' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- unless product.has_only_default_variant -%}
              <div class="attributes">
                {%- for option in product.options_with_values -%}
                  {%- assign option_name = option.name | downcase -%}
                  {%- if option_name == 'color' or option_name == 'colour' -%}
                    {%- comment -%}
                      Color is picked from round swatches of the shirt color.
                      The swatch color comes from the option's swatch in Shopify
                      admin if one is set, otherwise from the color-hex snippet
                      (Bella+Canvas 3001 colors, hex values from Printful).
                    {%- endcomment -%}
                    {%- assign option_position = forloop.index0 -%}
                    <fieldset class="swatches" data-swatches>
                      <legend class="swatches__legend">
                        {{ option.name }}: <span data-swatch-name>{{ option.selected_value }}</span>
                      </legend>
                      {%- for value in option.values -%}
                        {%- liquid
                          assign swatch_hex = value.swatch.color
                          if swatch_hex == blank
                            capture swatch_hex
                              render 'color-hex', color: value
                            endcapture
                            assign swatch_hex = swatch_hex | strip
                          endif
                          assign value_lower = value | downcase
                        -%}
                        <input
                          type="radio"
                          class="swatch__input visually-hidden"
                          id="Swatch-{{ section.id }}-{{ forloop.index0 }}"
                          name="swatch-{{ section.id }}"
                          value="{{ value | escape }}"
                          data-option-index="{{ option_position }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label
                          for="Swatch-{{ section.id }}-{{ forloop.index0 }}"
                          class="swatch{% if value_lower contains 'heather' %} swatch--heather{% endif %}"
                          style="--swatch: {{ swatch_hex | default: '#ccc' }}"
                          title="{{ value | escape }}"
                        ><span class="visually-hidden">{{ value }}</span></label>
                      {%- endfor -%}
                    </fieldset>
                  {%- else -%}
                    <div class="attribute-row">
                      <label class="attribute-row__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                      <select
                        id="Option-{{ section.id }}-{{ forloop.index0 }}"
                        class="form-select"
                        data-option-index="{{ forloop.index0 }}"
                        autocomplete="off"
                      >
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                        {%- endfor -%}
                      </select>
                      {%- if option_name == 'size' and section.settings.show_size_chart -%}
                        <button type="button" class="link-button" data-size-chart-open>Size chart</button>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="form-submit" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
              {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
            </button>
          {%- endform -%}

          {%- if section.settings.good_to_know != blank -%}
            <div class="good-to-know">
              <div class="product-info__label">{{ section.settings.good_to_know_heading }}</div>
              {{ section.settings.good_to_know }}
            </div>
          {%- endif -%}

          {%- comment -%} Prices are formatted here so the shop's currency format is used. {%- endcomment -%}
          <script type="application/json" data-variants>
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id }},
                  "options": {{ variant.options | json }},
                  "available": {{ variant.available | json }},
                  "price": {{ variant.price | money_without_trailing_zeros | json }},
                  "image": {% if variant.featured_media %}{{ variant.featured_media.preview_image | image_url: width: 700 | json }}{% else %}null{% endif %},
                  "image_full": {% if variant.featured_media %}{{ variant.featured_media.preview_image | image_url: width: 1600 | json }}{% else %}null{% endif %},
                  "image_alt": {{ variant.featured_media.alt | default: product.title | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        </div>
      </div>
    </div>

    {%- comment -%}
      Below the main photo: one square thumbnail per color showing the design
      printed on it; clicking it zooms to the shirt photo in that color. A design image is matched to a color
      by its alt text ending in ", <Color>" or " on <Color>" (e.g. "Major
      League Reading design, Black"). Colors without their own design image
      use the custom.thumbnail design. Any other product images follow.
    {%- endcomment -%}
    {%- liquid
      assign color_index = -1
      for option in product.options_with_values
        assign option_name = option.name | downcase
        if option_name == 'color' or option_name == 'colour'
          assign color_index = forloop.index0
        endif
      endfor
      assign used_media_ids = ','
    -%}
    {%- capture small_images -%}
      {%- if color_index >= 0 -%}
        {%- for color in product.options_with_values[color_index].values -%}
          {%- liquid
            assign color_mockup = nil
            for variant in product.variants
              if variant.options[color_index] == color and variant.featured_media
                assign color_mockup = variant.featured_media
                break
              endif
            endfor

            assign color_lower = color | downcase
            assign suffix_comma = ', ' | append: color_lower
            assign suffix_on = ' on ' | append: color_lower
            assign color_design = nil
            for media in product.media
              assign alt_lower = media.alt | downcase
              unless alt_lower contains 'design'
                continue
              endunless
              assign start_comma = alt_lower.size | minus: suffix_comma.size | at_least: 0
              assign start_on = alt_lower.size | minus: suffix_on.size | at_least: 0
              assign tail_comma = alt_lower | slice: start_comma, suffix_comma.size
              assign tail_on = alt_lower | slice: start_on, suffix_on.size
              if tail_comma == suffix_comma or tail_on == suffix_on
                assign color_design = media.preview_image
                assign used_media_ids = used_media_ids | append: media.id | append: ','
                break
              endif
            endfor
            if color_design == nil
              assign color_design = design_thumb
            endif
          -%}
          {%- if color_mockup or color_design != blank -%}
            {%- liquid
              if color_mockup
                assign used_media_ids = used_media_ids | append: color_mockup.id | append: ','
                assign zoom_image = color_mockup.preview_image
              else
                assign zoom_image = color_design
              endif
              if color_design != blank
                assign square_image = color_design
              else
                assign square_image = color_mockup.preview_image
              endif
            -%}
            {%- capture swatch_alt -%}{{ product.title }} on {{ color }}{%- endcapture -%}
            <div class="color-pair">
              <a href="{{ zoom_image | image_url: width: 1600 }}" title="See the shirt in {{ color | escape }}" data-lightbox>
                {{ square_image | image_url: width: 300, height: 300, crop: 'center' | image_tag: width: 150, height: 150, alt: swatch_alt, loading: 'lazy' }}
              </a>
              <div class="color-pair__label">{{ color }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif design_thumb != blank -%}
        {%- assign thumb_alt = design_thumb.alt | default: product.title -%}
        <a href="{{ design_thumb | image_url: width: 1600 }}" data-lightbox>
          {{ design_thumb | image_url: width: 300 | image_tag: width: 150, alt: thumb_alt, loading: 'lazy' }}
        </a>
      {%- endif -%}
      {%- for media in product.media -%}
        {%- assign media_key = ',' | append: media.id | append: ',' -%}
        {%- if used_media_ids contains media_key or variant_media_ids contains media_key or color_index < 0 and media.id == main_media.id -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign media_alt = media.alt | default: product.title -%}
        <a href="{{ media.preview_image | image_url: width: 1600 }}" data-lightbox>
          {{ media.preview_image | image_url: width: 300 | image_tag: width: 150, alt: media_alt, loading: 'lazy' }}
        </a>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if small_images != blank -%}
      <div class="img_small">{{ small_images }}</div>
    {%- endif -%}
  </div>
</div>

<dialog class="lightbox" data-lightbox-dialog>
  <form method="dialog"><button class="lightbox__close" aria-label="Close">×</button></form>
  <img alt="" width="1600" height="1600" data-lightbox-image>
  <button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Previous image" data-lightbox-prev>‹</button>
  <button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Next image" data-lightbox-next>›</button>
</dialog>

{%- if section.settings.show_size_chart -%}
  {%- comment -%}
    Bella+Canvas 3001 measurements, from Printful's size guide for the
    product (catalog id 71). Width is measured flat across the chest.
  {%- endcomment -%}
  <dialog class="size-chart" data-size-chart aria-labelledby="SizeChartTitle-{{ section.id }}">
    <form method="dialog"><button class="lightbox__close" aria-label="Close">×</button></form>
    <h2 id="SizeChartTitle-{{ section.id }}">Size chart</h2>
    <p>Unisex fit (Bella+Canvas 3001). Measurements are in inches, taken with the shirt laid flat, and can vary by about an inch.</p>
    <table class="size-chart__table">
      <thead>
        <tr><th scope="col">Size</th><th scope="col">S</th><th scope="col">M</th><th scope="col">L</th><th scope="col">XL</th><th scope="col">2XL</th><th scope="col">3XL</th></tr>
      </thead>
      <tbody>
        <tr><th scope="row">Length</th><td>28</td><td>29</td><td>30</td><td>31</td><td>32</td><td>33</td></tr>
        <tr><th scope="row">Width</th><td>18</td><td>20</td><td>22</td><td>24</td><td>26</td><td>28</td></tr>
        <tr><th scope="row">Fits chest</th><td>34–37</td><td>38–41</td><td>42–45</td><td>46–49</td><td>50–53</td><td>54–57</td></tr>
      </tbody>
    </table>
    <p class="size-chart__tip">Between sizes? Lay your favorite tee flat, measure across the chest, and pick the closest width.</p>
  </dialog>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_size_chart",
      "label": "Show size chart link",
      "default": true
    },
    {
      "type": "text",
      "id": "good_to_know_heading",
      "label": "Info heading",
      "default": "Good to know"
    },
    {
      "type": "richtext",
      "id": "good_to_know",
      "label": "Info under Add to cart",
      "default": "<ul><li>Printed just for you when you order, then shipped. Most orders ship within a week.</li><li>Soft Bella+Canvas 3001 unisex tee. Size up if you like a looser fit.</li><li>Misprinted or damaged? Email <a href=\"mailto:hello@tshirtbooyah.com\">hello@tshirtbooyah.com</a> and we'll make it right.</li></ul>"
    }
  ]
}
{% endschema %}
