<div id="product_container" class="text-page">
  <div class="detailentry">
    <div class="page_header"><h1>{{ shop.password_message | default: 'Opening soon' }}</h1></div>
    {%- form 'storefront_password', class: 'password-form' -%}
      {{ form.errors | default_errors }}
      <label for="Password">Store password</label>
      <input type="password" name="password" id="Password" class="form-text" autocomplete="current-password">
      <button type="submit" class="form-submit">Enter</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
