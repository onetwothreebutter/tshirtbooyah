{%- comment -%}
  PostHog analytics: pageviews, autocapture (clicks), session recordings and
  a few store events for the funnel:
    product_viewed -> product_added_to_cart -> cart_viewed -> checkout_button_clicked
  The checkout pages can't run theme code, so the checkout steps
  (checkout_started ... checkout_completed) come from the custom pixel in
  tools/posthog-checkout-pixel.js, pasted into Settings > Customer events.

  Turned on by the "PostHog project API key" theme setting. Not loaded in the
  theme editor, so editing the theme doesn't count as visits.
{%- endcomment -%}
{%- if settings.posthog_key != blank and request.design_mode == false -%}
  <script>
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group getSurveys onSessionId".split(" "),n=0;o.length>n;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
  </script>
  <script>
    posthog.init({{ settings.posthog_key | strip | json }}, {
      api_host: {{ settings.posthog_host | default: 'https://us.i.posthog.com' | json }},
      person_profiles: 'identified_only',
      autocapture: true,
      capture_pageview: true,
      capture_pageleave: true,
      disable_session_recording: false,
      session_recording: { maskAllInputs: true }
    });

    {%- if template.name == 'product' %}
    {%- assign ph_variant = product.selected_or_first_available_variant %}
    (function () {
      var product = {
        product_id: {{ product.id | json }},
        product_title: {{ product.title | json }},
        product_handle: {{ product.handle | json }},
        is_kids: {% if product.tags contains 'kids' %}true{% else %}false{% endif %},
        price: {{ ph_variant.price | divided_by: 100.0 | json }},
        currency: {{ cart.currency.iso_code | json }}
      };
      posthog.capture('product_viewed', product);

      document.addEventListener('DOMContentLoaded', function () {
        var form = document.querySelector('[data-product-form]');
        if (!form) return;
        form.addEventListener('submit', function () {
          var props = Object.assign({}, product);
          var idInput = form.querySelector('[data-variant-id]');
          props.variant_id = idInput ? Number(idInput.value) : null;
          var swatch = form.querySelector('[data-swatches] input:checked');
          if (swatch) props.color = swatch.value;
          var size = form.querySelector('select.form-select');
          if (size) props.size = size.value;
          // The form posts to /cart/add and the page navigates away, so send now.
          posthog.capture('product_added_to_cart', props, { send_instantly: true, transport: 'sendBeacon' });
        });
      });
    })();
    {%- endif %}

    {%- if template.name == 'cart' %}
    posthog.capture('cart_viewed', {
      item_count: {{ cart.item_count | json }},
      cart_total: {{ cart.total_price | divided_by: 100.0 | json }},
      currency: {{ cart.currency.iso_code | json }}
    });
    document.addEventListener('DOMContentLoaded', function () {
      var button = document.querySelector('.cart-form button[name="checkout"]');
      if (!button) return;
      button.addEventListener('click', function () {
        posthog.capture('checkout_button_clicked', {
          item_count: {{ cart.item_count | json }},
          cart_total: {{ cart.total_price | divided_by: 100.0 | json }}
        }, { send_instantly: true, transport: 'sendBeacon' });
      });
    });
    {%- endif %}
  </script>
{%- endif -%}
