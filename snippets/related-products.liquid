{%- comment -%}
  "You might also like" row of shirts (product page and cart).
  Picks shirts from the Home page collection (with the Iowa collection first
  for Iowa shirts), starting just after the current shirt so each product
  page shows a different set. Sold-out shirts and shirts in skip_ids are
  left out. Works on product objects directly (no all_products lookups,
  which Shopify caps at 20 per page).

  Usage:
    {% render 'related-products', current: product, limit: 4, heading: 'You might also like' %}
    {% render 'related-products', skip_ids: ',123,456,', limit: 3, heading: '...' %}
  skip_ids: product ids wrapped in commas, e.g. the products already in the cart.
{%- endcomment -%}
{%- liquid
  assign limit = limit | default: 4
  assign skip = skip_ids | default: ','

  assign list = collections['frontpage'].products
  if current and current.tags contains 'iowa'
    assign list = collections['iowa'].products | concat: collections['frontpage'].products
  endif
  assign total = list.size

  # Start right after the current shirt so the picks rotate between pages.
  assign start = 0
  if current
    for p in list
      if p.id == current.id
        assign start = forloop.index
        break
      endif
    endfor
    assign skip = skip | append: current.id | append: ','
  endif

  assign seen = ','
  assign count = 0
  capture items
    if total > 0
      for i in (1..total)
        if count >= limit
          break
        endif
        assign idx = start | plus: i | minus: 1 | modulo: total
        assign candidate = list[idx]
        assign id_key = ',' | append: candidate.id | append: ','
        if candidate.available == false or skip contains id_key or seen contains id_key
          continue
        endif
        assign seen = seen | append: candidate.id | append: ','
        assign count = count | plus: 1
        render 'product-thumb', product: candidate, show_details: true
      endfor
    endif
  endcapture
-%}
{%- if count > 0 -%}
  <div class="related">
    <h2 class="related__heading">{{ heading | default: 'You might also like' }}</h2>
    <div class="related__grid">{{ items }}</div>
  </div>
{%- endif -%}
