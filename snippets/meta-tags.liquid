{%- comment -%}
  Description, social share (Open Graph / Twitter) tags and product
  structured data. Rendered from layout/theme.liquid.

  Product pages share the product's main photo. Every other page shares
  assets/share-image.jpg (logo + a row of designs, 1200x630).
{%- endcomment -%}
{%- liquid
  assign default_description = "Funny/cool t-shirts by some dude in Iowa (It's on the map, look it up)."
  assign meta_description = page_description | default: default_description

  # About and Iowa keep their copy in theme blocks and Contact has no body, so Shopify
  # gives both the shop description. Give them their own unless an SEO
  # description has been set on the page in the admin.
  if template.name == 'page'
    if page_description == blank or page_description == shop.description
      case page.handle
        when 'about'
          assign meta_description = "Who's behind T-shirt Booyah: one guy in Iowa who likes llamas, raises blueberries and designs funny shirts, printed to order by Printful."
        when 'contact'
          assign meta_description = "Questions about an order, an idea for a shirt, or a pun you need to get off your chest? Get in touch with T-shirt Booyah."
        when 'iowa'
          assign meta_description = "Funny t-shirts for Iowans, made in Iowa by an Iowan: county fairs, gravel roads, marching bands and Midwest pride."
      endcase
    endif
  endif

  if template.name == 'index'
    assign og_title = shop.name | append: ' - Funny hand-printed t-shirts'
  else
    assign og_title = page_title | append: ' | ' | append: shop.name
  endif

  assign og_type = 'website'
  assign og_image = 'share-image.jpg' | asset_url | prepend: 'https:'
  assign og_image_width = 1200
  assign og_image_height = 630
  assign og_image_alt = 'T-shirt Booyah logo and a row of t-shirt designs'
  if template.name == 'product' and product.featured_media
    assign og_type = 'product'
    # Shopify never upscales, so a 1000px mockup is served at 1000px even
    # when 1200 is asked for. Report the size actually served.
    assign og_image = product.featured_media.preview_image | image_url: width: 1200 | prepend: 'https:'
    assign og_image_width = product.featured_media.preview_image.width | at_most: 1200
    assign og_image_height = og_image_width | divided_by: product.featured_media.preview_image.aspect_ratio | round
    assign og_image_alt = product.featured_media.alt | default: product.title
  endif
-%}
<meta name="description" content="{{ meta_description | escape }}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ meta_description | escape }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:secure_url" content="{{ og_image }}">
<meta property="og:image:width" content="{{ og_image_width }}">
<meta property="og:image:height" content="{{ og_image_height }}">
<meta property="og:image:alt" content="{{ og_image_alt | escape }}">
{%- if template.name == 'product' %}
<meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | escape }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ meta_description | escape }}">
<meta name="twitter:image" content="{{ og_image }}">

{%- if template.name == 'product' %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProductGroup",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    "description": {{ product.description | strip_html | strip | json }},
    "productGroupID": {{ product.id | append: '' | json }},
    "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
    {%- if product.featured_media %}
    "image": {{ product.featured_media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif %}
    "variesBy": [
      {%- for option in product.options_with_values -%}
        {%- assign option_name = option.name | downcase -%}
        {%- if option_name == 'color' or option_name == 'colour' -%}"https://schema.org/color"{%- elsif option_name == 'size' -%}"https://schema.org/size"{%- else -%}{{ option.name | json }}{%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor -%}
    ],
    "hasVariant": [
      {%- for variant in product.variants %}
      {
        "@type": "Product",
        "name": {{ product.title | append: ' - ' | append: variant.title | json }},
        "sku": {{ variant.sku | default: variant.id | json }},
        {%- for option in product.options_with_values -%}
          {%- assign option_name = option.name | downcase -%}
          {%- if option_name == 'color' or option_name == 'colour' %}
        "color": {{ variant.options[forloop.index0] | json }},
          {%- elsif option_name == 'size' %}
        "size": {{ variant.options[forloop.index0] | json }},
          {%- endif -%}
        {%- endfor %}
        {%- if variant.featured_media %}
        "image": {{ variant.featured_media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }},
        {%- endif %}
        "offers": {
          "@type": "Offer",
          "url": {{ shop.url | append: variant.url | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition"
        }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor %}
    ]
  }
</script>
{%- endif %}
