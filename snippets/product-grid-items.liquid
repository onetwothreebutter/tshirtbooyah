{%- comment -%}
  The squares and pager for one page of the home grid.
  Usage: {% render 'product-grid-items', products: <paginated products>, paginate: paginate, hide_kids: 'hide', only_in: 'frontpage' %}
  hide_kids: 'hide' leaves out products tagged "kids" (they get their own grid).
  only_in: a collection handle (e.g. 'frontpage'); products not in it are left out.
  Used so the home grid keeps the all-products order but skips shirts taken out
  of the "Home page" collection (the Iowa-only shirts live on /pages/iowa).
{%- endcomment -%}
{%- for product in products -%}
  {%- if hide_kids == 'hide' and product.tags contains 'kids' -%}{%- continue -%}{%- endif -%}
  {%- if only_in != blank -%}
    {%- assign product_collections = product.collections | map: 'handle' -%}
    {%- unless product_collections contains only_in -%}{%- continue -%}{%- endunless -%}
  {%- endif -%}
  {% render 'product-thumb', product: product %}
{%- else -%}
  <p class="empty-note">No shirts yet. Add products in Shopify admin.</p>
{%- endfor -%}
{% render 'pager', paginate: paginate %}
