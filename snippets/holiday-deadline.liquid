{%- comment -%}
  Holiday "order by" note (product page and cart). Dates are theme settings
  (Theme settings > Holiday deadline), written YYYY-MM-DD. Before the standard
  date it says order by then; between the two dates it points to express
  shipping; after the express date it disappears on its own.
  Usage: {% render 'holiday-deadline' %}
{%- endcomment -%}
{%- liquid
  assign today = 'now' | date: '%Y-%m-%d'
  assign standard = settings.holiday_standard_date | strip
  assign express = settings.holiday_express_date | strip
  assign holiday = settings.holiday_name | default: 'Christmas'
-%}
{%- if standard != blank and today <= standard -%}
  <p class="holiday-note">Order by <strong>{{ standard | date: '%A, %B %-d' }}</strong> for {{ holiday }} delivery in the US.</p>
{%- elsif express != blank and today <= express -%}
  <p class="holiday-note">Need it by {{ holiday }}? Order by <strong>{{ express | date: '%A, %B %-d' }}</strong> and choose express shipping at checkout (US).</p>
{%- endif -%}
